# 2. A tiny cosmology calculation (astropy): distance modulus at z = 0.5\
from astropy.cosmology import FlatLambdaCDM\
import astropy.units as u\
cosmo = FlatLambdaCDM(H0=70 * u.km / u.s / u.Mpc, Om0=0.3)\
mu05 = cosmo.distmod(0.5).value\
print(f"mu(z=0.5) = \{mu05:.3f\} mag")\
assert abs(mu05 - 42.27) < 0.1, "unexpected distance modulus"\
