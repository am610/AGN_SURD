# 3. A 30-second emcee run: fit a straight line to noisy data\
import numpy as np\
rng = np.random.default_rng(42)\
x = np.linspace(0, 10, 50)\
y = 2.0 * x + 1.0 + rng.normal(0, 1.0, x.size)\
\
def log_prob(theta, x, y):\
    m, b = theta\
    if abs(m) > 10 or abs(b) > 10:\
        return -np.inf\
    return -0.5 * np.sum((y - (m * x + b)) ** 2)\
\
nwalkers, ndim = 16, 2\
p0 = rng.normal([2, 1], 0.1, (nwalkers, ndim))\
sampler = emcee.EnsembleSampler(nwalkers, ndim, log_prob, args=(x, y))\
sampler.run_mcmc(p0, 2000, progress=True)\
flat = sampler.get_chain(discard=500, thin=5, flat=True)\
m_fit, b_fit = flat.mean(axis=0)\
print(f"m = \{m_fit:.3f\} (true 2.0),  b = \{b_fit:.3f\} (true 1.0)")\
assert abs(m_fit - 2.0) < 0.2 and abs(b_fit - 1.0) < 0.7\
\
\
# 4. Corner plot renders\
import matplotlib.pyplot as plt\
fig = corner.corner(flat, labels=["m", "b"], truths=[2.0, 1.0])\
plt.show()\
\
